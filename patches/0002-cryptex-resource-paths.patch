+
+/*
+ * Custom SRD cryptexes are mounted below a randomized directory rather than
+ * at the root paths configured at build time.  launchd exposes that directory
+ * as CRYPTEX_MOUNT_PATH.  Prefix only compiled global resource paths; user
+ * startup files continue to come from HOME/ZDOTDIR.
+ */
+
+/**/
+mod_export void
+sourceglobal(char *s)
+{
+    char *mount = zgetenv("CRYPTEX_MOUNT_PATH");
+
+    if (mount && *mount && *s == '/') {
+	VARARR(char, buf, strlen(mount) + strlen(s) + 1);
+	sprintf(buf, "%s%s", mount, s);
+	source(buf);
+    } else {
+	source(s);
+    }
+}
 
